diff --git a/format.mjs b/format.mjs
index e3b57b2..1b659fb 100644
--- a/format.mjs
+++ b/format.mjs
@@ -1 +1,8 @@
-export function money(cents) { return "TODO"; }
+export function money(cents) {
+  if (!Number.isInteger(cents)) {
+    throw new RangeError("money expects integer cents");
+  }
+  const abs = BigInt(Math.abs(cents));
+  const sign = cents < 0 ? "-" : "";
+  return `${sign}$${abs / 100n}.${String(abs % 100n).padStart(2, "0")}`;
+}
diff --git a/invoice.mjs b/invoice.mjs
index 10c1afc..7bdb593 100644
--- a/invoice.mjs
+++ b/invoice.mjs
@@ -1 +1,6 @@
-export function invoice(items) { return "TODO"; }
+import {subtotal} from './pricing.mjs';
+import {money} from './format.mjs';
+
+export function invoice(items) {
+  return `Total: ${money(subtotal(items))}`;
+}
diff --git a/pricing.mjs b/pricing.mjs
index e3eb42f..d80df76 100644
--- a/pricing.mjs
+++ b/pricing.mjs
@@ -1 +1,14 @@
-export function subtotal(items) { return 0; }
+function isNonNegativeInteger(value) {
+  return Number.isInteger(value) && value >= 0;
+}
+
+export function subtotal(items) {
+  let total = 0;
+  for (const {priceCents, quantity} of items) {
+    if (!isNonNegativeInteger(priceCents) || !isNonNegativeInteger(quantity)) {
+      throw new RangeError('priceCents and quantity must be non-negative integers');
+    }
+    total += priceCents * quantity;
+  }
+  return total;
+}
