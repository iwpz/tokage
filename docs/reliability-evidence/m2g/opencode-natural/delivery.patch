diff --git a/format.mjs b/format.mjs
index e3b57b2..2016e9c 100644
--- a/format.mjs
+++ b/format.mjs
@@ -1 +1,13 @@
-export function money(cents) { return "TODO"; }
+/**
+ * Format an integer number of cents as a dollar string.
+ *
+ * @param {number} cents integer number of cents
+ * @returns {string} e.g. "$0.00", "$1.05", "-$1.05", "$1200.00"
+ */
+export function money(cents) {
+  const sign = cents < 0 ? "-" : "";
+  const absolute = Math.abs(cents);
+  const dollars = Math.floor(absolute / 100);
+  const remainder = absolute % 100;
+  return `${sign}$${dollars}.${String(remainder).padStart(2, "0")}`;
+}
diff --git a/invoice.mjs b/invoice.mjs
index 10c1afc..c09674e 100644
--- a/invoice.mjs
+++ b/invoice.mjs
@@ -1 +1,13 @@
-export function invoice(items) { return "TODO"; }
+import { subtotal } from "./pricing.mjs";
+import { money } from "./format.mjs";
+
+/**
+ * Build the invoice total line for the given line items.
+ *
+ * @param {Array<{ priceCents: number, quantity: number }>} items
+ * @returns {string} `"Total: " + money(subtotal(items))`
+ * @throws {RangeError} propagated from subtotal for invalid items
+ */
+export function invoice(items) {
+  return "Total: " + money(subtotal(items));
+}
diff --git a/pricing.mjs b/pricing.mjs
index e3eb42f..a22c333 100644
--- a/pricing.mjs
+++ b/pricing.mjs
@@ -1 +1,20 @@
-export function subtotal(items) { return 0; }
+/**
+ * Sum the integer-cent value of each line item.
+ *
+ * @param {Array<{ priceCents: number, quantity: number }>} items
+ * @returns {number} integer sum of priceCents * quantity
+ * @throws {RangeError} if any priceCents or quantity is not an integer, or is negative
+ */
+export function subtotal(items) {
+  let total = 0;
+  for (const { priceCents, quantity } of items) {
+    if (!Number.isInteger(priceCents) || priceCents < 0) {
+      throw new RangeError('priceCents must be a non-negative integer');
+    }
+    if (!Number.isInteger(quantity) || quantity < 0) {
+      throw new RangeError('quantity must be a non-negative integer');
+    }
+    total += priceCents * quantity;
+  }
+  return total;
+}
