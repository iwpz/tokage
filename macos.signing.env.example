# macOS 代码签名 + 公证凭证（本地专用，已加入 .gitignore，勿提交 Git）
# 用法：
#   cp macos.signing.env.example macos.signing.env
#   编辑 macos.signing.env 填入下列值（或直接复用 ../fish-idle/client/macos.signing.env）
#   ./build_macos_release.sh
#
# 支持的参数：
#   ./build_macos_release.sh              # 检测到凭证时默认执行 Developer ID 签名 + Apple 公证
#   ./build_macos_release.sh --sign-only  # 仅做 Developer ID 签名，跳过公证（快速本地出包）
#   ./build_macos_release.sh --no-sign    # 不使用开发者证书（Ad-hoc 签名）

# Apple ID 邮箱（开发者账号登录邮箱）
APPLE_ID=you@example.com

# App 专用密码（https://appleid.apple.com -> 登录与安全 -> App 专用密码）
# 兼容 APPLE_APP_SPECIFIC_PASSWORD 与 Tauri 原生 APPLE_PASSWORD
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 开发者团队 ID（10 位字母数字，见 Apple Developer Membership details）
APPLE_TEAM_ID=XXXXXXXXXX

# 签名证书身份（推荐填 `security find-identity -v -p codesigning` 输出的 40 位 SHA-1 哈希或完整名称）
# 兼容 CSC_NAME 与 Tauri 原生 APPLE_SIGNING_IDENTITY
CSC_NAME=3B40C796E191929F11FA15952265E5E67F4A976A
